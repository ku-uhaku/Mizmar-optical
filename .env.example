# --- Database / cache / storage (host ports avoid clashes) ---
DATABASE_URL=postgresql://mizmar:mizmar@localhost:5433/mizmar?schema=public
DATABASE_URL_TEST=postgresql://mizmar:mizmar@localhost:5433/mizmar_test?schema=public
REDIS_URL=redis://localhost:6380

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=mizmar
S3_SECRET_KEY=mizmar-secret
S3_BUCKET=mizmar
S3_FORCE_PATH_STYLE=true

# --- API ---
API_PORT=3001
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# --- Apps ---
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Server-side (storefront SSR) API URL; defaults to NEXT_PUBLIC_API_URL. Use the internal hostname in containers.
API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# --- Locale ---
DEFAULT_LOCALE=fr
DEFAULT_CURRENCY=MAD

# --- Seed super-admin ---
SEED_ADMIN_EMAIL=admin@mizmar.local
SEED_ADMIN_PASSWORD=Password!

# --- Providers (placeholders) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER_KEY=
