// ============================================================================
// 3. INVENTORY
// ============================================================================

enum StockMovementType {
  INITIAL
  PURCHASE_RECEIPT
  SALE
  SALE_RETURN
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  COUNT_CORRECTION
  LAB_CONSUMPTION
  SUPPLIER_RETURN
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum AdjustmentReason {
  DAMAGED
  LOST
  FOUND
  EXPIRED
  CORRECTION
  OTHER
}

enum CountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Warehouse {
  id        String    @id @default(cuid())
  storeId   String
  code      String
  name      String
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  store            Store             @relation(fields: [storeId], references: [id])
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  stockLevels      StockLevel[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  inventoryCounts  InventoryCount[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]

  @@unique([storeId, code])
  @@index([storeId])
}

model StockLevel {
  id           String    @id @default(cuid())
  variantId    String
  warehouseId  String
  quantity     Int       @default(0)
  reserved     Int       @default(0) // held by unpaid/online orders
  reorderPoint Int       @default(0) // low-stock alert threshold
  reorderQty   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@index([warehouseId])
}

/// Append-only stock ledger. `quantity` is signed; `balanceAfter` snapshots the level.
model StockMovement {
  id           String            @id @default(cuid())
  storeId      String
  variantId    String
  warehouseId  String
  type         StockMovementType
  quantity     Int
  balanceAfter Int
  unitCost     Decimal?          @db.Decimal(12, 2)
  refType      String? // "Order" | "GoodsReceipt" | "StockTransfer" | ...
  refId        String?
  lotNumber    String?
  expiryDate   DateTime?         @db.Date
  note         String?
  actorId      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([storeId, type])
  @@index([refType, refId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  storeId         String // origin store (scoping)
  number          String
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  note            String?
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdById     String?
  receivedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@unique([storeId, number])
  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferLine {
  id          String    @id @default(cuid())
  transferId  String
  variantId   String
  quantity    Int
  receivedQty Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
  @@index([variantId])
}

model StockAdjustment {
  id          String           @id @default(cuid())
  storeId     String
  warehouseId String
  number      String
  reason      AdjustmentReason
  note        String?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  lines     StockAdjustmentLine[]

  @@unique([storeId, number])
  @@index([warehouseId])
}

model StockAdjustmentLine {
  id            String    @id @default(cuid())
  adjustmentId  String
  variantId     String
  quantityDelta Int
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  variant    ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([adjustmentId])
  @@index([variantId])
}

model InventoryCount {
  id          String      @id @default(cuid())
  storeId     String
  warehouseId String
  number      String
  status      CountStatus @default(DRAFT)
  note        String?
  startedAt   DateTime?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse            @relation(fields: [warehouseId], references: [id])
  lines     InventoryCountLine[]

  @@unique([storeId, number])
  @@index([warehouseId])
}

model InventoryCountLine {
  id          String    @id @default(cuid())
  countId     String
  variantId   String
  expectedQty Int
  countedQty  Int?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  count   InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([countId, variantId])
  @@index([variantId])
}
