// ============================================================================
// 11. FINANCE
// (Payments, refunds, credit notes and tax rates live in 05_sales.)
// ============================================================================

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  REJECTED
}

enum CashFlowDirection {
  IN
  OUT
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  parentId  String?
  code      String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   ExpenseCategory?  @relation("ExpenseCategoryTree", fields: [parentId], references: [id])
  children ExpenseCategory[] @relation("ExpenseCategoryTree")
  expenses Expense[]
}

model BankAccount {
  id             String    @id @default(cuid())
  storeId        String?
  name           String
  bankName       String?
  iban           String?
  currency       String    @default("MAD")
  openingBalance Decimal   @default(0) @db.Decimal(14, 2)
  isCashAccount  Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  expenses         Expense[]
  cashFlow         CashFlowEntry[]
  supplierPayments SupplierPayment[]

  @@index([storeId])
}

model Expense {
  id            String        @id @default(cuid())
  storeId       String
  categoryId    String
  supplierId    String?
  bankAccountId String?
  methodId      String?
  number        String
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  status        ExpenseStatus @default(DRAFT)
  incurredAt    DateTime      @db.Date
  paidAt        DateTime?
  attachmentUrl String?
  createdById   String?
  approvedById  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  bankAccount BankAccount?    @relation(fields: [bankAccountId], references: [id])

  @@unique([storeId, number])
  @@index([storeId, incurredAt])
  @@index([categoryId])
}

/// Denormalised cash-flow ledger written whenever a payment / expense / refund is posted.
model CashFlowEntry {
  id            String            @id @default(cuid())
  storeId       String
  bankAccountId String?
  direction     CashFlowDirection
  amount        Decimal           @db.Decimal(12, 2)
  source        String // ORDER_PAYMENT | REFUND | EXPENSE | SUPPLIER_PAYMENT | PAYROLL | ...
  refType       String?
  refId         String?
  description   String?
  occurredAt    DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([storeId, occurredAt])
  @@index([refType, refId])
}
